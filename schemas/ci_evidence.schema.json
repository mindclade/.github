{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/schemas/ci-evidence/v1.0.0",
  "title": "Mindclade CI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "correlation_id",
    "source_revision",
    "base_revision",
    "context_digest",
    "caller_repository",
    "workflow_ref",
    "workflow_revision",
    "pipeline_definition_revision",
    "producer",
    "plan_id",
    "build_id",
    "conclusion",
    "reason_code",
    "checks",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "correlation_id": { "$ref": "#/$defs/correlationId" },
    "source_revision": { "$ref": "#/$defs/gitSha" },
    "base_revision": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
    "context_digest": { "$ref": "#/$defs/sha256Digest" },
    "caller_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "workflow_ref": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" },
    "workflow_revision": { "$ref": "#/$defs/gitSha" },
    "pipeline_definition_revision": { "$ref": "#/$defs/gitSha" },
    "producer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$" },
    "plan_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "build_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "conclusion": { "enum": ["PASS", "FAIL", "CANNOT_EVALUATE"] },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "conclusion", "report_digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "conclusion": { "enum": ["PASS", "FAIL", "CANNOT_EVALUATE"] },
        "report_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    }
  }
}
