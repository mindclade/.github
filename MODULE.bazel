module(
    name = "mindclade_github",
    version = "0.1.0",
    bazel_compatibility = [
        ">=9.1.1",
        "<=9.1.1",
    ],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.3.2")

# rules_python 2.3.2 maps the 3.13 minor line to CPython 3.13.13.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.13")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13", "pythons_hub")

register_toolchains("@pythons_hub//:all")

# Keep third-party command-line validators hermetic. Each repository contains
# exactly one executable or a checksum-pinned source closure; platform
# selection happens in the root BUILD.bazel.
http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)

http_file(
    name = "opa_darwin_amd64",
    downloaded_file_path = "opa",
    executable = True,
    sha256 = "2e0ba7a7a45940ac4c7df878af269ebd86b221d4776f746a7fa0b6d85ba209d4",
    urls = ["https://github.com/open-policy-agent/opa/releases/download/v1.20.1/opa_darwin_amd64"],
)

http_file(
    name = "opa_darwin_arm64",
    downloaded_file_path = "opa",
    executable = True,
    sha256 = "2b805d476099f81828e0a72466f23b7c5f7035e8e51823f5e1ef3cbf4f2321ce",
    urls = ["https://github.com/open-policy-agent/opa/releases/download/v1.20.1/opa_darwin_arm64"],
