# yamllint is a pure-Python build tool. Its complete runtime closure is fetched
# from immutable PyPI release artifacts and exposed through generated external
# BUILD files, so no repository-local dependency or lock path is required.
http_archive(
    name = "mindclade_pyyaml",
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "pyyaml",
    srcs = glob(["lib/yaml/**/*.py"]),
    imports = ["lib"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f",
    strip_prefix = "pyyaml-6.0.3",
    urls = ["https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz"],
)

http_archive(
    name = "mindclade_pathspec",
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "pathspec",
    srcs = glob(["pathspec/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "a482d51503a1ab33b1c67a6c3813a26953dbdc71c31dacaef9a838c4e29f5712",
    strip_prefix = "pathspec-0.12.1",
    urls = ["https://files.pythonhosted.org/packages/ca/bc/f35b8446f4531a7cb215605d100cd88b7ac6f44ab3fc94870c120ab3adbf/pathspec-0.12.1.tar.gz"],
)

http_archive(
    name = "mindclade_yamllint",
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "yamllint_cli",
    srcs = glob(["yamllint/**/*.py"]),
    main = "yamllint/__main__.py",
    data = glob(["yamllint/conf/*"]),
    imports = ["."],
    deps = [
        "@mindclade_pathspec//:pathspec",
        "@mindclade_pyyaml//:pyyaml",
    ],
    legacy_create_init = 0,
    visibility = ["//visibility:public"],
)
""",
    sha256 = "81f7c0c5559becc8049470d86046b36e96113637bcbe4753ecef06977c00245d",
    strip_prefix = "yamllint-1.37.1",
    urls = ["https://files.pythonhosted.org/packages/46/f2/cd8b7584a48ee83f0bc94f8a32fea38734cefcdc6f7324c4d3bfc699457b/yamllint-1.37.1.tar.gz"],
)
